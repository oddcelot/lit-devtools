{
  "name": "@oddsquad/vite-plugin-lit",
  "version": "0.24.0",
  "description": "Lit for Vite and Astro: true HMR, server rendering and a DevTools panel",
  "license": "BSD-3-Clause",
  "author": "oddcelot",
  "homepage": "https://vite-plugin-lit.oddsquad.dev/",
  "keywords": [
    "vite-plugin",
    "vite",
    "lit",
    "hmr",
    "web-components",
    "devtools",
    "withastro",
    "renderer"
  ],
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "files": [
    "/CHANGELOG.md",
    "/THIRD_PARTY_NOTICES.md",
    "/lib/",
    "/dist/client/",
    "/dist/standalone/",
    "/types/",
    "/index.{d.ts,d.ts.map,js,js.map}",
    "/build.{d.ts,d.ts.map,js,js.map}",
    "/astro.{d.ts,d.ts.map,js,js.map}",
    "/client.d.ts",
    "/bin.mjs"
  ],
  "bin": {
    "lit-devtools": "./bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.js"
    },
    "./astro": {
      "types": "./astro.d.ts",
      "default": "./astro.js"
    },
    "./astro/server": {
      "types": "./lib/astro/server.d.ts",
      "default": "./lib/astro/server.js"
    },
    "./astro/client": {
      "types": "./lib/astro/client.d.ts",
      "default": "./lib/astro/client.js"
    },
    "./astro/boot": {
      "types": "./lib/astro/boot.d.ts",
      "default": "./lib/astro/boot.js"
    },
    "./astro/polyfill": {
      "types": "./lib/astro/polyfill.d.ts",
      "default": "./lib/astro/polyfill.js"
    },
    "./css.js": {
      "types": "./lib/runtime/css.d.ts",
      "default": "./lib/runtime/css.js"
    },
    "./connect.js": {
      "types": "./lib/runtime/rpc-transport.d.ts",
      "default": "./lib/runtime/rpc-transport.js"
    },
    "./devframe": {
      "types": "./lib/devframe/embed.d.ts",
      "default": "./lib/devframe/embed.js"
    },
    "./uno": {
      "types": "./lib/uno-sheet.d.ts",
      "default": "./lib/uno-sheet.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./bin": "./bin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/vite-plugin-lit.git"
  },
  "bugs": {
    "url": "https://github.com/oddcelot/vite-plugin-lit/issues"
  },
  "scripts": {
    "build": "pnpm run generate:tokens && tsc --pretty && pnpm run build:panel && pnpm run build:standalone && node scripts/format-build-output.mjs && node scripts/check-self-types.mjs",
    "build:lit-canary": "node scripts/build-lit-canary.mjs",
    "dev": "pnpm run build && vp dev playground",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node scripts/check-client-types.mjs && vp test run --project unit --project dom",
    "coverage": "vp test run --project unit --project dom --coverage",
    "test:e2e": "pnpm run build && pnpm run build:extension && vp test run --project e2e",
    "changelog": "git-cliff --unreleased",
    "changelog:language-server": "git-cliff --config packages/lit-language-server/cliff.toml --unreleased",
    "changelog:oxlint-plugin": "git-cliff --config packages/oxlint-plugin-lit/cliff.toml --unreleased",
    "changelog:vscode": "git-cliff --config packages/vscode/cliff.toml --unreleased",
    "fallow": "fallow",
    "fallow:check": "fallow --health-baseline fallow-baselines/health.json",
    "fallow:coverage": "pnpm run coverage && fallow health --coverage .fallow/coverage",
    "bench": "node bench/run.mjs",
    "bench:serve": "node bench/run.mjs --serve",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:shots": "pnpm run build && node scripts/docs-shots.mjs",
    "chrome:clean": "node scripts/chrome-profile.mjs",
    "format": "vp fmt \"**/*.{cjs,html,js,json,md,mdx,ts,yaml}\"",
    "format:check": "vp fmt \"**/*.{cjs,html,js,json,md,mdx,ts,yaml}\" --check",
    "prepublishOnly": "pnpm exec vp check && pnpm run test:unit && pnpm run build",
    "prepare": "vp config",
    "build:panel": "vp build src/panel",
    "generate:tokens": "node packages/webawesome-theme-lit/scripts/generate.mjs",
    "build:standalone": "vp build src/standalone",
    "standalone:demo": "pnpm run build && pnpm --dir playground run standalone",
    "build:extension": "vp build extension && vp build extension --mode page && vp build extension --mode content",
    "build:extension:firefox": "node scripts/build-extension-firefox.mjs",
    "extension:try": "node scripts/extension-try.mjs",
    "extension:smoke:firefox": "node scripts/extension-firefox-smoke.mjs",
    "extension:assets": "node scripts/extension-assets.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "devframe": "^1.1.0",
    "es-module-lexer": "^3.0.2",
    "launch-editor": "^2.14.1",
    "magic-string": "^1.4.2",
    "oxc-parser": "^0.150.0",
    "oxc-resolver": "^11.24.2"
  },
  "peerDependencies": {
    "@devframes/agentic": "^1.0.0",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@vitejs/devtools-kit": "^0.7.5",
    "astro": "^7.3.0",
    "cac": "^7.0.0",
    "lightningcss": "^1.30.0",
    "lit": "^3.0.0",
    "unocss": "^66.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@devframes/agentic": {
      "optional": true
    },
    "@lit-labs/ssr": {
      "optional": true
    },
    "@lit-labs/ssr-client": {
      "optional": true
    },
    "@vitejs/devtools-kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "cac": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": "^7.0.0 || ^8.0.0"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "Needs the Vite dev server and its HMR API."
    },
    "rolldown": {
      "type": "incompatible",
      "reason": "Needs the Vite dev server and its HMR API."
    }
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@devframes/agentic": "1.1.0",
    "@devframes/service-open": "1.1.0",
    "@fontsource-variable/lilex": "^5.3.0",
    "@lit-labs/signals": "^0.3.0",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@phosphor-icons/core": "^2.1.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@vitejs/devtools-kit": "0.7.6",
    "@vitest/coverage-v8": "5.0.1",
    "cac": "7.0.0",
    "fallow": "^3.32.0",
    "git-cliff": "^2.14.2",
    "happy-dom": "^20.14.5",
    "jsr": "0.14.3",
    "lightningcss": "^1.33.0",
    "lintapple": "^0.1.20",
    "lit": "^3.3.3",
    "playwright-core": "^1.63.0",
    "sugar-high": "^2.5.2",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4"
}
