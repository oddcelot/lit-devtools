{
  // The panel is a Lit SPA using decorators (@customElement, @state), unlike
  // the rest of this package (plain customElements.define). Vite builds it
  // (`vp build src/panel`, and the extension's build), and in dev serves its
  // .ts files to the DevTools iframe via /@fs/; esbuild only lowers TS
  // decorators when the *nearest* tsconfig sets experimentalDecorators, so
  // this panel-local config gives just these files the Lit settings.
  //
  // The root `tsc` program excludes src/panel: nothing it emits imports the
  // panel. This config only type-checks (vp check), so `rootDir` spans the
  // repo, which lets the panel import packages/lit-components' source.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    // The figures import their recordings (src/panel/figures).
    "resolveJsonModule": true,
    "rootDir": "../.."
  },
  "include": ["**/*.ts"],
  // Not the root's: it excludes src/panel, and `extends` would inherit that.
  "exclude": []
}
