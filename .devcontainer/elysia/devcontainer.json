{
  // GitHub Codespaces for examples/elysia: Lit server-rendered by Elysia on
  // Bun, with the Lit DevTools docked in the page.
  "name": "Lit on Elysia (examples/elysia)",
  "build": {"dockerfile": "Dockerfile"},
  // The plugin is built from this checkout and linked into the example, so
  // the example runs the code of the branch the codespace was made from.
  "postCreateCommand": "pnpm install --filter vite-plugin-lit-elysia-example... && pnpm run build",
  // In a terminal of its own: the DevTools print their one-time code there.
  // Each forwarded port gets its own https://<codespace>-<port>.app.github.dev
  // origin; see PREVIEW_ORIGIN in examples/elysia/src/dev.ts.
  "postAttachCommand": {
    "guestbook": "cd examples/elysia && PREVIEW_ORIGIN='https://*.app.github.dev' bun run dev"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {"label": "Guestbook", "onAutoForward": "openBrowser"}
  },
  "customizations": {
    "codespaces": {"openFiles": ["examples/elysia/README.md"]}
  }
}
