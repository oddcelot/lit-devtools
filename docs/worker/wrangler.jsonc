// A Worker on the docs' route, in front of GitHub Pages. Pages serves the
// site; this adds the response headers Pages can't set and answers
// `Accept: text/markdown`. It has no assets of its own: fetch() from a route
// Worker to its own host goes to the origin. Deploy by hand when
// src/index.js changes: `pnpm run worker:deploy` in docs/.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "vite-plugin-lit-docs",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Only the homepage and the content sections. The Worker acts on pages
  // alone, and every request it runs on counts toward the free plan's 100k
  // a day; a page view also loads ~20 assets from /_astro/, /demo/, /og/ and
  // /pagefind/, which these patterns leave out. A new top-level docs section
  // needs its own pattern here, or its pages go without the Link headers and
  // Markdown negotiation. Set each route to fail open in the dashboard
  // (Workers > vite-plugin-lit-docs > Domains & Routes): past the daily cap
  // the site then serves straight from Pages instead of erroring.
  "routes": [
    {"pattern": "lit-devtools.oddsquad.dev/", "zone_name": "oddsquad.dev"},
    {
      "pattern": "lit-devtools.oddsquad.dev/start/*",
      "zone_name": "oddsquad.dev",
    },
    {
      "pattern": "lit-devtools.oddsquad.dev/guides/*",
      "zone_name": "oddsquad.dev",
    },
    {
      "pattern": "lit-devtools.oddsquad.dev/concepts/*",
      "zone_name": "oddsquad.dev",
    },
    {
      "pattern": "lit-devtools.oddsquad.dev/reference/*",
      "zone_name": "oddsquad.dev",
    },
    {
      "pattern": "lit-devtools.oddsquad.dev/contributing/*",
      "zone_name": "oddsquad.dev",
    },
  ],
}
