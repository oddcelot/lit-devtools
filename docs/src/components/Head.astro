---
/**
 * Starlight's `Head` with the font tags appended. Astro's font pipeline emits
 * its `@font-face` rules through the `<Font>` component rather than a
 * stylesheet, so they have to be injected into the head from here — Starlight
 * owns that element, and `components.Head` is the seam it offers.
 *
 * Lilex, the code font, is not preloaded: it only appears once a code block
 * or an inline `code` scrolls into view. Body text is the system sans and
 * loads nothing.
 *
 * The changelog pages also get the video player: their release videos come
 * from CHANGELOG.md as markup (docs/scripts/sync-changelog.mjs), with no
 * component to load it, unlike DemoVideo.
 *
 * Every page registers the docs' WebMCP tools.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import {Font} from 'astro:assets';
import VideoPlayerScript from './VideoPlayerScript.astro';
import WebMcpTools from './WebMcpTools.astro';

const changelog = Astro.url.pathname.includes('/reference/changelog/');
---

<Default />
<Font cssVariable="--font-lilex" />
{changelog && <VideoPlayerScript />}
<WebMcpTools />
