---
/**
 * The DevTools Timeline in Tracks mode, running in the page over a recorded
 * session (src/panel/timeline-figure.ts). It renders in the browser only: the
 * panel's elements have no server rendering, so the figure holds its height
 * empty until the script runs.
 */
interface Props {
  /** What the figure shows, under it. */
  caption: string;
}
const {caption} = Astro.props;
---

<figure class="timeline-figure not-content">
  <docs-timeline-figure></docs-timeline-figure>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import '../panel/timeline-figure.ts';
</script>

<style>
  .timeline-figure {
    margin-block: 1.5rem;
  }
  docs-timeline-figure:not(:defined) {
    display: block;
    height: 28rem;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
