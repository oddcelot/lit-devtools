---
/**
 * A video from `public/demo/`, in Video.js's packaged skin
 * (VideoPlayerScript.astro). By default a short demo: muted autoplay on a
 * loop, like a moving screenshot, with controls to pause it or turn the
 * music on. With `autoplay={false}` it is a film: the poster until someone
 * presses play, and nothing downloaded before that. Files in `public/` are
 * not processed, so the paths carry the base.
 */
import VideoPlayerScript from './VideoPlayerScript.astro';

interface Props {
  /** What the video shows, for screen readers. */
  label: string;
  /** File stem in `public/demo/`: `<name>.mp4` and `<name>-poster.jpg`. */
  name?: string;
  width?: number;
  height?: number;
  /** Muted looping autoplay (a demo) or play on request (a film). */
  autoplay?: boolean;
}

const {
  label,
  name = 'hmr-demo',
  width = 1440,
  height = 902,
  autoplay = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="demo-video">
  <video-player>
    <video-skin>
      <video
        src={`${base}/demo/${name}.mp4`}
        width={width}
        height={height}
        aria-label={label}
        autoplay={autoplay}
        muted={autoplay}
        loop={autoplay}
        playsinline
        preload={autoplay ? 'metadata' : 'none'}></video>
      <img slot="poster" src={`${base}/demo/${name}-poster.jpg`} alt="" />
    </video-skin>
  </video-player>
</figure>
<VideoPlayerScript />

<style>
  .demo-video {
    margin: 1.5rem 0;
  }
</style>
