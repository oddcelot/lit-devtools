---
/**
 * A short demo video from `public/demo/`. Muted autoplay on a loop, like a
 * moving screenshot; the player's controls are there to pause it or turn the
 * music on. Plays in Video.js's packaged skin (VideoPlayerScript.astro).
 * Files in `public/` are not processed, so the paths carry the base.
 */
import VideoPlayerScript from './VideoPlayerScript.astro';

interface Props {
  /** What the video shows, for screen readers. */
  label: string;
  /** File stem in `public/demo/`: `<name>.mp4` and `<name>-poster.jpg`. */
  name?: string;
  width?: number;
  height?: number;
}

const {label, name = 'hmr-demo', width = 1440, height = 902} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="demo-video">
  <video-player>
    <video-skin>
      <video
        src={`${base}/demo/${name}.mp4`}
        width={width}
        height={height}
        aria-label={label}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"></video>
      <img slot="poster" src={`${base}/demo/${name}-poster.jpg`} alt="" />
    </video-skin>
  </video-player>
</figure>
<VideoPlayerScript />

<style>
  .demo-video {
    margin: 1.5rem 0;
  }
</style>
