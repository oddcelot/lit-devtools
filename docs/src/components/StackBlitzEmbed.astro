---
/**
 * A directory of this repo running on StackBlitz, embedded in the page. Each
 * embed is a WebContainer that installs and starts a dev server, too heavy
 * to boot on scroll, so the iframe is only created on a click. StackBlitz's
 * `ctl=1` click-to-load does not apply to GitHub imports.
 *
 * Nothing loads from StackBlitz before that click, and the Run button says
 * what the click does: it boots the project on StackBlitz, which receives
 * the visitor's IP address and runs code from this repo.
 *
 * The embed needs a cross-origin isolated page, which `coi-sw.js` provides
 * from the page's next load: the first Run reloads the page once, then
 * starts the embed. The caption has a button that reloads just the iframe,
 * next to a link that opens the project in a full StackBlitz tab.
 *
 * An example published as a live demo (src/lib/live-examples.ts) opens on
 * that instead: the DevTools panel inspecting the example, in an iframe of
 * this site's own, with nothing to boot. A switch above it brings up the
 * StackBlitz embed. The live frame is `credentialless`, so it still loads
 * once the page is cross-origin isolated for StackBlitz.
 */
import {liveDemoUrl} from '../lib/live-examples';
interface Props {
  /** Directory in the repo, such as `examples/flame`. */
  path: string;
  /** What the embed shows, for screen readers. */
  title: string;
  /** File open in the editor. */
  file?: string;
  /** npm script to run instead of the project's `startCommand`. */
  startScript?: string;
}

const {path, title, file, startScript} = Astro.props;
const live = liveDemoUrl(path);

const project = `https://stackblitz.com/github/oddcelot/vite-plugin-lit/tree/main/${path}`;
const query = (extra: Record<string, string>) => {
  const params = new URLSearchParams(extra);
  if (file !== undefined) params.set('file', file);
  if (startScript !== undefined) params.set('startScript', startScript);
  const search = params.toString();
  return search === '' ? project : `${project}?${search}`;
};
---

<figure class="stackblitz-embed" data-view={live ? 'live' : 'stackblitz'}>
  {
    live && (
      <div class="views not-content" role="group" aria-label="Show the demo">
        <button type="button" data-view="live" aria-pressed="true">
          Live
        </button>
        <button type="button" data-view="stackblitz" aria-pressed="false">
          StackBlitz
        </button>
      </div>
    )
  }
  {
    live && (
      <live-demo class="live" data-src={live}>
        <iframe credentialless title={`${title}, live with the DevTools panel`} />
      </live-demo>
    )
  }
  <stackblitz-embed data-src={query({embed: '1', hideExplorer: '1'})}>
    <lit-run-gate data-title={title}>
      Runs on StackBlitz: starting it connects to stackblitz.com, which
      installs and runs this project in your browser (<a
        href="https://stackblitz.com/privacy-policy">StackBlitz's privacy
        policy</a
      >).
    </lit-run-gate>
  </stackblitz-embed>
  <figcaption>
    <lit-button appearance="plain" class="reload" hidden>
      Stuck? Reload the demo
    </lit-button>
    <a href={query({})}>Open in StackBlitz</a>
    {live && <a href={live}>Open the live demo in a tab</a>}
  </figcaption>
</figure>

<script>
  import type {LitButton} from '@oddsquad/lit-components/button.js';
  import type {LitRunGate} from '@oddsquad/lit-components/run-gate.js';
  import '@oddsquad/lit-components/button.js';
  import '@oddsquad/lit-components/run-gate.js';
  import {whenNear} from '../lib/near-viewport';

  // A WebContainer embed runs only on a cross-origin isolated page, in a
  // `credentialless` iframe; otherwise StackBlitz shows "Unable to run
  // Embedded Project". Only Chromium has `credentialless` iframes. The
  // isolation headers come from coi-sw.js, a service worker next to this
  // page, which takes effect from the next load of the page.
  const canEmbed =
    'credentialless' in HTMLIFrameElement.prototype &&
    'serviceWorker' in navigator;
  // The embed to start once the page comes back isolated.
  const PENDING = 'stackblitz-embed:pending';

  if (canEmbed) {
    void navigator.serviceWorker.register(
      `${import.meta.env.BASE_URL.replace(/\/$/, '')}/start/demos/coi-sw.js`,
    );
  }

  class StackBlitzEmbed extends HTMLElement {
    connectedCallback() {
      const gate = this.querySelector<LitRunGate>('lit-run-gate');
      const reload =
        this.closest('figure')?.querySelector<LitButton>('.reload');
      if (gate === null || reload === null || reload === undefined) return;
      const src = this.dataset.src ?? '';

      const start = () => {
        const frame = document.createElement('iframe');
        frame.setAttribute('credentialless', '');
        frame.allow = 'cross-origin-isolated';
        frame.src = src;
        frame.title = gate.dataset.title ?? '';
        gate.replaceWith(frame);
        reload.hidden = false;
        reload.addEventListener('click', () => {
          frame.src = src;
        });
      };
      const unsupported = (text: string) => {
        gate.unsupported = text;
      };

      if (!canEmbed) {
        unsupported(
          'StackBlitz runs embedded demos only in Chromium-based browsers. Open this one in StackBlitz instead.',
        );
        return;
      }
      if (sessionStorage.getItem(PENDING) === src) {
        sessionStorage.removeItem(PENDING);
        // Reloaded for this embed; if the worker still did not isolate the
        // page, say so instead of reloading again.
        if (crossOriginIsolated) {
          start();
          this.scrollIntoView({block: 'center'});
        } else {
          unsupported(
            'This page could not enable the isolation the embed needs. Open this demo in StackBlitz instead.',
          );
        }
        return;
      }
      gate.addEventListener('run', async () => {
        if (crossOriginIsolated) {
          start();
          return;
        }
        gate.busy = true;
        sessionStorage.setItem(PENDING, src);
        await navigator.serviceWorker.ready;
        location.reload();
      });
    }
  }
  customElements.define('stackblitz-embed', StackBlitzEmbed);

  /**
   * The live demo: its frame loads once it comes near the viewport, in the
   * docs' colour scheme, and reloads when the theme switch changes it.
   */
  class LiveDemo extends HTMLElement {
    connectedCallback() {
      const frame = this.querySelector('iframe');
      if (frame === null) return;
      const load = () => {
        const scheme = document.documentElement.dataset.theme ?? 'dark';
        if (frame.dataset.scheme === scheme) return;
        frame.dataset.scheme = scheme;
        frame.src = `${this.dataset.src}?scheme=${scheme}`;
      };
      whenNear(this, () => {
        load();
        new MutationObserver(load).observe(document.documentElement, {
          attributeFilter: ['data-theme'],
        });
      });
    }
  }
  customElements.define('live-demo', LiveDemo);

  // The Live / StackBlitz switch of an example that has both. A page
  // reloaded to start an embed opens that embed's figure on StackBlitz.
  for (const figure of document.querySelectorAll<HTMLElement>(
    '.stackblitz-embed:has(.views)',
  )) {
    const buttons = figure.querySelectorAll<HTMLButtonElement>('.views button');
    const show = (view: string) => {
      figure.dataset.view = view;
      for (const b of buttons)
        b.setAttribute('aria-pressed', String(b.dataset.view === view));
    };
    for (const b of buttons)
      b.addEventListener('click', () => show(b.dataset.view ?? 'live'));
    const embed = figure.querySelector<HTMLElement>('stackblitz-embed');
    if (sessionStorage.getItem(PENDING) === embed?.dataset.src)
      show('stackblitz');
  }
</script>

<style>
  .stackblitz-embed {
    margin: 1.5rem 0;
  }
  stackblitz-embed {
    display: grid;
    place-items: center;
    height: 32rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--sl-color-gray-6);
  }
  .stackblitz-embed[data-view='live'] stackblitz-embed,
  .stackblitz-embed[data-view='stackblitz'] live-demo {
    display: none;
  }
  live-demo {
    display: block;
    height: 40rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  live-demo iframe,
  stackblitz-embed :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .views {
    display: inline-flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
    padding: 0.2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-md);
  }
  .views button {
    padding: 0.2rem 0.75rem;
    border: 0;
    border-radius: calc(var(--radius-md) - 0.2rem);
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .views button[aria-pressed='true'] {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }
  .stackblitz-embed figcaption {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
