---
/**
 * One of the live demos (src/pages/demo/, or the live panel) in a frame,
 * with a caption that says what to try. The landing page uses it, and so do
 * the Overview pages in the docs. The frame loads when it comes within a
 * screen of the viewport (src/lib/near-viewport.ts), so on the landing page
 * the hero's is the only one on first paint.
 */
import Glow from './Glow.astro';

interface Props {
  src: string;
  title: string;
  /** Any CSS length. */
  height: string;
  /** The height on a phone, where the demos stack; `height` by default. */
  narrowHeight?: string;
  /** What the visitor can try, under the frame. */
  caption?: string;
  /** The hero's frame loads at once. */
  eager?: boolean;
  id?: string;
  /** The frame takes the page's scheme in its URL (`?scheme=`, as the live
   *  panel pages do), set here and again when the theme changes. */
  themed?: boolean;
}

const {
  src,
  title,
  height,
  narrowHeight = height,
  caption,
  eager = false,
  id,
  themed = false,
} = Astro.props;
---

<figure class="demo-frame not-content">
  <Glow>
    <iframe
      id={id}
      src={eager && !themed ? src : undefined}
      data-frame-src={eager && !themed ? undefined : src}
      data-themed={themed ? '' : undefined}
      title={title}
      style={{'--height': height, '--narrow-height': narrowHeight}}></iframe>
  </Glow>
  {caption && <figcaption set:html={caption} />}
</figure>

<script>
  import {whenNear} from '../../lib/near-viewport';

  const frames = document.querySelectorAll<HTMLIFrameElement>(
    'iframe[data-frame-src]'
  );
  const show = (frame: HTMLIFrameElement) => {
    if (!('themed' in frame.dataset)) {
      frame.src = frame.dataset.frameSrc!;
      return;
    }
    const scheme = document.documentElement.dataset.theme ?? 'dark';
    if (frame.dataset.scheme === scheme) return;
    frame.dataset.scheme = scheme;
    frame.src = `${frame.dataset.frameSrc}?scheme=${scheme}`;
  };
  for (const frame of frames) {
    whenNear(frame, () => show(frame));
  }
  // A themed frame that has loaded follows the theme switch.
  new MutationObserver(() => {
    for (const frame of frames) {
      if (frame.dataset.scheme !== undefined) show(frame);
    }
  }).observe(document.documentElement, {attributeFilter: ['data-theme']});
</script>

<style>
  .demo-frame {
    margin: 0;
  }
  /* In a docs page, the same rhythm as the other figures. */
  :global(.sl-markdown-content) .demo-frame {
    margin-block: 1.5rem;
  }
  iframe {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--bg);
    height: var(--height);
  }
  @media (max-width: 40rem) {
    iframe {
      height: var(--narrow-height);
    }
  }
  figcaption {
    margin-top: 0.85rem;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  figcaption :global(strong) {
    color: var(--text-secondary);
  }
</style>
