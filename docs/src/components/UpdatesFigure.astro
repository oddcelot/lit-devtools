---
/**
 * The DevTools Updates tab, running in the page over a recorded session
 * (src/panel/figures/updates-figure.ts, shared with the kitchen sink). It
 * renders in the browser only: the panel's elements have no server
 * rendering, so the figure holds its height empty until the script runs.
 */
interface Props {
  /** What the figure shows, under it. */
  caption: string;
  /** A tag name: open with that component's updates showing. */
  component?: string;
}
const {caption, component} = Astro.props;
---

<figure class="updates-figure not-content">
  <updates-figure component={component}></updates-figure>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import '../../../src/panel/figures/updates-figure.ts';
</script>

<style>
  .updates-figure {
    margin-block: 1.5rem;
  }
  updates-figure:not(:defined) {
    display: block;
    height: 30rem;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
