---
/**
 * Starlight's splash hero, rebuilt for the landing page, its only user. The
 * landing page has no hero image, so the column Starlight keeps for one holds
 * Lit Inspector instead: the extension is the other way in, and a reader who
 * only wants to inspect a live site should not have to scroll to find it.
 * Above the title, a pill names the newest release and links its changelog
 * page.
 *
 * Only `title`, `tagline` and `actions` from the `hero` frontmatter are
 * read; an `image` is not supported.
 */
import {LinkButton} from '@astrojs/starlight/components';
import StoreButtons from './StoreButtons.astro';
import inspectorIcon from '../../../extension/public/icon.svg';
import changelog from '../../../CHANGELOG.md?raw';
import {latestRelease} from '../lib/latest-release.mjs';

const {data} = Astro.locals.starlightRoute.entry;
const {title = data.title, tagline, actions = []} = data.hero ?? {};
const release = latestRelease(changelog);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const released = new Date(`${release.date}T00:00:00Z`).toLocaleDateString(
  'en',
  {month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'}
);
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <a class="release not-content" href={`${base}${release.path}`}>
        <span class="release-version">v{release.version}</span>
        <span class="release-text">What's new · {released}</span>
        <span aria-hidden="true">→</span>
      </a>
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(({attrs = {}, icon, link, text, variant}) => (
            <LinkButton href={link} {variant} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <aside class="inspector not-content" aria-labelledby="inspector-title">
    <img src={inspectorIcon.src} alt="" width="48" height="48" />
    <p id="inspector-title" class="inspector-title">Lit Inspector</p>
    <p class="inspector-text">
      The same panel in Chrome and Firefox DevTools, for production builds and
      sites you don't serve. No Vite needed.
    </p>
    <StoreButtons />
    <a class="inspector-more" href={`${base}/guides/devtools/browser-extension/`}>
      How the extension works →
    </a>
  </aside>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 100%;
    align-items: center;
    gap: 2rem;
    padding-bottom: 1rem;
  }
  .stack {
    flex-direction: column;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: center;
  }
  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .copy > * {
    max-width: 50ch;
  }
  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }
  .actions {
    gap: 1rem 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .release {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem 0.25rem 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-pill);
    background: var(--lit-accent-soft);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .release:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .release-version {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    font-weight: 600;
  }

  .inspector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-lg);
    background: var(--sl-color-gray-6);
    text-align: center;
  }
  .inspector p {
    margin: 0;
  }
  .inspector-title {
    font-size: var(--sl-text-xl);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .inspector-text {
    color: var(--sl-color-gray-2);
    max-width: 34ch;
  }
  .inspector :global(.store-buttons) {
    justify-content: center;
    margin-block: 0.5rem;
  }
  .inspector-more {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-accent-high);
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 7fr 4fr;
      gap: 3%;
      padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
    }
    .stack {
      text-align: start;
    }
    .copy {
      align-items: flex-start;
    }
    .actions {
      justify-content: flex-start;
    }
  }
</style>
