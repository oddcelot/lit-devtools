---
/**
 * The HMR demo (src/lib/demos/hmr-demo.ts): an editor and the component it
 * shows, running once without the plugin and once with it. A frame of its
 * own, because the plugin's patcher hooks `customElements.define` for the
 * whole document, and the landing page's own elements should not go
 * through it.
 */
import {Font} from 'astro:assets';
import '@oddsquad/webawesome-theme-lit/tokens.css';
import '../../styles/demo-frame.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>HMR demo</title>
    <Font cssVariable="--font-lilex" />
    <script is:inline>
      // The theme before the first paint; theme.ts follows it from there.
      (() => {
        const t = localStorage.getItem('starlight-theme');
        const theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <main class="hmr">
      <section class="editor window" aria-label="Component source">
        <header class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="file">src/demo-counter.ts</span>
        </header>
        <pre id="code" class="code"></pre>
        <footer class="edits">
          <span class="label">Make an edit</span>
          <button data-edit="title" type="button">Rename the heading</button>
          <button data-edit="accent" type="button">Change the colour</button>
          <button data-edit="note" type="button">Add a line</button>
          <button id="restart" class="ghost" type="button" title="Start over">
            Start over
          </button>
        </footer>
      </section>

      <section class="pane window cold-window" aria-labelledby="cold-title">
        <header class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span id="cold-title" class="who">Plain Vite</span>
          <span class="tag">full reload</span>
        </header>
        <div id="cold" class="stage"></div>
        <p id="cold-status" class="status" aria-live="polite"></p>
      </section>

      <section class="pane window hot-window" aria-labelledby="hot-title">
        <header class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span id="hot-title" class="who">With vite-plugin-lit</span>
          <span class="tag accent">hot patch</span>
        </header>
        <div id="hot" class="stage"></div>
        <p id="hot-status" class="status" aria-live="polite"></p>
      </section>
    </main>

    <script>
      import '../../lib/demos/hmr-demo.ts';
    </script>
  </body>
</html>

<style>
  .hmr {
    height: 100vh;
    box-sizing: border-box;
    padding: 0.75rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    grid-template-areas:
      'editor cold'
      'editor hot';
  }
  .editor {
    grid-area: editor;
  }
  .cold-window {
    grid-area: cold;
  }
  .hot-window {
    grid-area: hot;
  }
  @media (max-width: 40rem) {
    .hmr {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'editor editor'
        'cold hot';
    }
    .hmr .code {
      font-size: 0.7rem;
    }
    .hmr .code :global(.ln) {
      display: none;
    }
    .hmr .stage {
      padding: 0.7rem;
    }
    .hmr .tag {
      display: none;
    }
  }

  .code {
    flex: 1;
    margin: 0;
    padding: 0.75rem 0;
    overflow: auto;
    font: 0.84rem/1.7 var(--font-lilex, ui-monospace, monospace);
    color: var(--code-default);
    counter-reset: line;
  }
  .code :global(.line) {
    display: block;
    padding-inline: 0.75rem 1rem;
    white-space: pre;
    border-left: 2px solid transparent;
  }
  .code :global(.line.changed) {
    background: var(--success-soft);
    border-left-color: var(--success);
    animation: changed 1.6s var(--ease-out);
  }
  @keyframes changed {
    from {
      background: color-mix(in srgb, var(--success) 45%, transparent);
    }
  }
  .code :global(.ln) {
    display: inline-block;
    width: 1.6rem;
    margin-right: 0.75rem;
    text-align: right;
    color: var(--text-muted);
    opacity: 0.6;
    user-select: none;
  }
  .code :global(.kw) {
    color: var(--code-keyword);
  }
  .code :global(.deco) {
    color: var(--code-callee);
  }
  .code :global(.str) {
    color: var(--code-string);
  }
  .code :global(.tick) {
    color: var(--code-tag);
  }

  .edits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border-top: 1px solid var(--border);
  }
  .label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }
  .edits button {
    font: 600 0.8rem/1 var(--font-sans);
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--text-strong);
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-standard);
  }
  .edits button:hover,
  .edits button:global(.pressed) {
    background: var(--accent);
    color: var(--on-accent);
  }
  .edits button:global(.pressed) {
    transform: scale(0.96);
  }
  .edits button.ghost {
    margin-left: auto;
    border-color: transparent;
    background: none;
    color: var(--text-muted);
  }
  .edits button.ghost:hover {
    background: var(--surface-hover);
    color: var(--text);
  }

  .who {
    font-weight: 700;
    color: var(--text-strong);
  }
  .tag {
    margin-left: auto;
    font: 600 0.68rem/1 var(--font-lilex, ui-monospace, monospace);
    padding: 0.25rem 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--warning-soft);
    color: var(--warning);
  }
  .tag.accent {
    background: var(--success-soft);
    color: var(--success);
  }
  .stage {
    flex: 1;
    padding: 0.9rem 1rem;
    transition: opacity 0.15s;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }
  .stage:global(.reloading) {
    opacity: 0;
  }
  .stage:global(.flash) {
    animation: flash 1.1s var(--ease-out);
  }
  @keyframes flash {
    from {
      box-shadow: inset 0 0 0 2px var(--success);
      background: var(--success-soft);
    }
  }
  .status {
    margin: 0;
    padding: 0.45rem 1rem;
    font: 0.74rem/1.3 var(--font-lilex, ui-monospace, monospace);
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    min-height: 1.3em;
  }
  .status[data-tone='ok'] {
    color: var(--success);
  }
  .status[data-tone='warn'] {
    color: var(--warning);
  }
  @media (prefers-reduced-motion: reduce) {
    .code :global(.line.changed),
    .stage:global(.flash) {
      animation: none;
    }
  }
</style>
