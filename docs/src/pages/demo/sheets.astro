---
/**
 * The stylesheet demo (src/lib/demos/sheets-demo.ts): a thousand shadow
 * roots, recoloured through one shared sheet or a `<style>` in each. A
 * frame of its own, so the thousand elements stay out of the landing
 * page's DOM.
 */
import {Font} from 'astro:assets';
import '@oddsquad/webawesome-theme-lit/tokens.css';
import '../../styles/demo-frame.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Stylesheet demo</title>
    <Font cssVariable="--font-lilex" />
    <script is:inline>
      (() => {
        const t = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      })();
    </script>
  </head>
  <body>
    <main class="sheets window">
      <header class="bar controls">
        <div class="segmented" role="group" aria-label="How the styles ship">
          <button data-mode="shared" aria-pressed="true" type="button">
            One shared sheet
          </button>
          <button data-mode="inline" aria-pressed="false" type="button">
            &lt;style&gt; in each
          </button>
        </div>
        <div class="colours" role="group" aria-label="Recolour">
          <button
            data-colour="var(--lit-blue-bright)"
            aria-pressed="true"
            style="--c: var(--lit-blue-bright)"
            type="button">Blue</button
          >
          <button
            data-colour="var(--lit-cyan)"
            aria-pressed="false"
            style="--c: var(--lit-cyan)"
            type="button">Cyan</button
          >
          <button
            data-colour="hsl(268 90% 66%)"
            aria-pressed="false"
            style="--c: hsl(268 90% 66%)"
            type="button">Violet</button
          >
          <button
            data-colour="var(--warning)"
            aria-pressed="false"
            style="--c: var(--warning)"
            type="button">Amber</button
          >
        </div>
      </header>
      <div id="grid" class="grid" aria-hidden="true"></div>
      <footer class="stats">
        <div><span data-stat="roots"></span><small>shadow roots</small></div>
        <div><span data-stat="sheets"></span><small>stylesheets</small></div>
        <div>
          <span data-stat="renders" class="renders"></span><small
            >re-renders</small
          >
        </div>
        <div><span data-stat="time"></span><small>to recolour</small></div>
      </footer>
    </main>
    <script>
      import '../../lib/demos/sheets-demo.ts';
    </script>
  </body>
</html>

<style>
  .sheets {
    height: 100vh;
    box-sizing: border-box;
  }
  .controls {
    flex-wrap: wrap;
    justify-content: space-between;
    row-gap: 0.5rem;
  }
  .segmented,
  .colours {
    display: flex;
    gap: 0.3rem;
  }
  .segmented {
    padding: 0.2rem;
    border-radius: var(--radius-pill);
    background: var(--surface-container);
  }
  button {
    font: 600 0.78rem/1 var(--font-sans);
    border: 0;
    cursor: pointer;
    color: var(--text-secondary);
    background: none;
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.7rem;
  }
  .segmented [aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .colours button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border);
  }
  .colours button::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c);
  }
  .colours [aria-pressed='true'] {
    border-color: var(--c);
    color: var(--text-strong);
  }
  .grid {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    padding: 0.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(0.8rem, 1fr));
    align-content: start;
    gap: 3px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
  }
  .stats div {
    display: grid;
    padding: 0.55rem 0.9rem;
  }
  .stats div + div {
    border-left: 1px solid var(--border-subtle);
  }
  .stats span {
    font: 700 1.15rem/1.2 var(--font-lilex, ui-monospace, monospace);
    color: var(--text-strong);
  }
  :root[data-mode='shared'] .renders {
    color: var(--success);
  }
  :root[data-mode='inline'] .renders {
    color: var(--warning);
  }
  .stats small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .stats :global(.bump) {
    animation: bump 0.6s var(--ease-out);
  }
  @keyframes bump {
    from {
      transform: translateY(-3px);
      opacity: 0.4;
    }
  }
</style>
