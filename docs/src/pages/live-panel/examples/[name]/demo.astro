---
/**
 * The page the live panel inspects for an example: examples/<name>/
 * index.html's styles and markup (src/lib/live-example-page.ts), with the
 * example's entry module loaded behind the page runtime instead of a dev
 * server's client. Its public/ files are served beside it
 * (`liveExamplesPublic` in astro.config.mjs), so its root-relative URLs,
 * rewritten to this page's, find them.
 */
import {examplePage} from '../../../../lib/live-example-page';
import {
  liveDemoUrl,
  liveExamplePaths,
  liveExamples,
} from '../../../../lib/live-examples';

export const getStaticPaths = liveExamplePaths;

const {name} = Astro.params;
const base = `${liveDemoUrl(`examples/${name}`)}demo/`;
const {title, head, body} = examplePage(name, base);
// An example built with its own vite.config.ts: its build, beside this page
// (src/lib/live-examples-own-build.mjs).
const ownBuild =
  liveExamples[name]?.build === 'own-config'
    ? `${base}_live/live-example.js`
    : undefined;
---

<!doctype html>
<html lang="en" data-live-example={name} data-live-build={ownBuild}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Fragment set:html={head} />
    {ownBuild && <link rel="stylesheet" href={`${base}_live/live-example.css`} />}
  </head>
  <body>
    <Fragment set:html={body} />
    <script>
      import {startDemoPage} from '../../../../../../src/panel/figures/live/demo-runtime.ts';
      import {liveExampleLoaders} from '../../../../lib/live-example-loaders';

      // The page names its example; its entry loads once the runtime's
      // hooks are in (demo-runtime.ts). An example built with its own config
      // names that build, which loads the same way.
      const {liveExample = '', liveBuild} = document.documentElement.dataset;
      const load =
        liveExampleLoaders[liveExample] ??
        (liveBuild !== undefined
          ? () => import(/* @vite-ignore */ liveBuild)
          : undefined);
      if (load !== undefined) await startDemoPage(load);
    </script>
  </body>
</html>
