---
import '../components/island-probe.ts';
import {IslandProbe} from '../components/island-probe.ts';
import Showcase from '../components/Showcase.astro';
import Demo from '../layouts/Demo.astro';
---

<Demo
  title="Islands"
  lede="Use a Lit class as a component and it becomes an island: Astro's client directives decide when it hydrates."
>
  <Showcase
    title="Right away, or when the browser is idle"
    code={`import {IslandProbe} from '../components/island-probe.ts';

<island-probe label="plain tag"></island-probe>
<IslandProbe label="client:load" client:load />
<IslandProbe label="client:idle" client:idle />
<IslandProbe label="client:only" client:only="lit" />`}
  >
    <p slot="explain">
      A plain tag hydrates as soon as a page script defines its class. An
      island waits for its directive: <code>client:load</code> at once,{' '}
      <code>client:idle</code> once the browser has nothing else to do.
      <code>client:only</code> has no server HTML: Astro creates the element in
      the browser.
    </p>
    <island-probe id="plain" label="plain tag"></island-probe>
    <IslandProbe id="load" label="client:load" client:load />
    <IslandProbe id="idle" label="client:idle" client:idle />
    <IslandProbe id="only" label='client:only="lit"' client:only="lit" />
    <p slot="try">
      Throttle the CPU in your browser's DevTools and reload: the gap between
      load and idle grows.
    </p>
  </Showcase>

  <Showcase
    title="When a media query matches"
    code={`<IslandProbe label="client:media" client:media="(max-width: 760px)" />`}
  >
    <p slot="explain">
      <code>client:media</code> hydrates once its query matches. Until then the
      element is server HTML, styled and readable, but its button does nothing.
    </p>
    <IslandProbe
      id="media"
      label='client:media="(max-width: 760px)"'
      client:media="(max-width: 760px)"
    />
    <p slot="try">
      Make the window narrower than 760px: the badge turns green when the query
      matches.
    </p>
  </Showcase>

  <Showcase
    title="When it scrolls into view"
    code={`<IslandProbe label="client:visible" client:visible />`}
  >
    <p slot="explain">
      <code>client:visible</code> hydrates when the element enters the
      viewport. Scroll down to it and watch the badge.
    </p>
    <div class="spacer"><span>Keep scrolling</span></div>
    <IslandProbe id="visible" label="client:visible" client:visible />
  </Showcase>

  <script>
    import '../components/island-probe.ts';
  </script>
</Demo>

<style>
  .spacer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 120vh;
    padding-block: var(--space-9);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    color: var(--text-muted);
  }
  /* Held in view while the spacer is: below the window's top edge as it
     scrolls past, above the bottom edge as it comes in. */
  .spacer span {
    position: sticky;
    top: var(--space-12);
    bottom: var(--space-12);
  }
</style>
