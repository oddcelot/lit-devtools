---
import Clicker from '../components/Clicker.tsx';
import LitInPreact from '../components/LitInPreact.tsx';
import {IslandProbe} from '../components/island-probe.ts';
import Showcase from '../components/Showcase.astro';
import Demo from '../layouts/Demo.astro';
---

<Demo
  title="Next to Preact"
  lede="Lit shares a project, and a page, with another framework's renderer."
>
  <Showcase
    title="Islands side by side"
    code={`// astro.config.mjs
integrations: [preact({include: ['**/*.tsx']}), lit()]

<Clicker client:load />
<IslandProbe client:load label="client:load" />
<IslandProbe client:only="lit" label='client:only="lit"' />`}
  >
    <p slot="explain">
      Each renderer hydrates its own islands. The Lit renderer is named{' '}
      <code>lit</code>, which is the hint <code>client:only</code> takes: with
      two renderers in the project, <code>client:only="lit"</code> is how Astro
      knows which one renders the island.
    </p>
    <div class="preact"><Clicker client:load /></div>
    <IslandProbe id="lit" label="client:load" client:load />
    <IslandProbe id="lit-only" label='client:only="lit"' client:only="lit" />
  </Showcase>

  <Showcase
    title="Lit inside Preact"
    code={`// LitInPreact.tsx
<ssr-counter start={5} />
<tag-list tags={tags} />
<button onClick={() => setTags([...tags, 'more'])}>…</button>`}
    lang="tsx"
  >
    <p slot="explain">
      Inside another framework's component, Lit elements are that framework's
      to render. On the server Preact writes them as plain tags, and Lit
      renders them in the browser once their classes load. Preact's hydration
      leaves properties as the server's HTML had them, so the hydrated
      island's array arrives with its first state change; rendered by Preact
      in the browser, it has it at once.
    </p>
    <LitInPreact id="hydrated" client:load />
    <LitInPreact id="browser" client:only="preact" />
    <p slot="try">
      The first list starts empty: add a tag from Preact and the whole array
      arrives.
    </p>
  </Showcase>
</Demo>

<style>
  .preact :global(button) {
    justify-self: start;
  }
  :global(.lit-in-preact) {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
</style>
