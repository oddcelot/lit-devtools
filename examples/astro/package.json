{
  "name": "vite-plugin-lit-astro-example",
  "description": "Lit components server-rendered by Astro through @oddsquad/vite-plugin-lit's renderer and hydrated in the page, hot-patched in dev, with the Lit panel in Astro's dev toolbar.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:server": "astro dev --config astro.server.config.mjs",
    "build:server": "astro build --config astro.server.config.mjs",
    "start:server": "node dist/server/entry.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "astro": "^7.3.5",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@oddsquad/vite-plugin-lit": "*",
    "@astrojs/node": "^11.1.8",
    "vitest": "^5.0.5"
  }
}
