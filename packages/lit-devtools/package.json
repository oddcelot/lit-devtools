{
  "name": "@oddsquad/lit-devtools",
  "version": "0.24.0",
  "description": "Lit DevTools in one install: the Vite and Astro plugin with true HMR and a DevTools panel, the language server's settings, and Oxlint rules for Lit templates.",
  "keywords": [
    "lit",
    "lit-element",
    "web-components",
    "vite",
    "astro",
    "devtools",
    "hmr",
    "oxlint",
    "language-server"
  ],
  "homepage": "https://vite-plugin-lit.oddsquad.dev/",
  "bugs": "https://github.com/oddcelot/lit-devtools/issues",
  "license": "BSD-3-Clause",
  "author": "oddcelot",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddcelot/lit-devtools.git",
    "directory": "packages/lit-devtools"
  },
  "bin": {
    "lit-devtools": "./bin/lit-devtools.mjs",
    "lit-language-server": "./bin/lit-language-server.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.js"
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./css.js"
    },
    "./astro": {
      "types": "./astro.d.ts",
      "default": "./astro.js"
    },
    "./uno": {
      "types": "./uno.d.ts",
      "default": "./uno.js"
    },
    "./devframe": {
      "types": "./devframe.d.ts",
      "default": "./devframe.js"
    },
    "./oxlint": {
      "types": "./oxlint.d.ts",
      "default": "./oxlint.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../CHANGELOG.md', 'CHANGELOG.md')\""
  },
  "dependencies": {
    "@oddsquad/lit-language-server": "workspace:^",
    "@oddsquad/oxlint-plugin-lit": "workspace:^",
    "@oddsquad/vite-plugin-lit": "workspace:^"
  },
  "peerDependencies": {
    "@devframes/agentic": "^1.0.0",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@vitejs/devtools-kit": "^0.7.5",
    "astro": "^7.3.0",
    "cac": "^7.0.0",
    "lightningcss": "^1.30.0",
    "lit": "^3.0.0",
    "unocss": "^66.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@devframes/agentic": {
      "optional": true
    },
    "@lit-labs/ssr": {
      "optional": true
    },
    "@lit-labs/ssr-client": {
      "optional": true
    },
    "@vitejs/devtools-kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "cac": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
