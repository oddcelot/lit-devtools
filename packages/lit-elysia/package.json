{
  "name": "@oddsquad/lit-elysia",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental: a Lit framework on Elysia 2. Pages from files, rendered on the server with @lit-labs/ssr, streamed and hydrated, with the Vite plugin's HMR in dev.",
  "license": "BSD-3-Clause",
  "author": "oddcelot",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./node": "./src/node.ts",
    "./routes": "./src/links.ts",
    "./eden": "./src/eden.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./page": {
        "types": "./dist/page.d.mts",
        "default": "./dist/page.mjs"
      },
      "./server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "./client": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "./routes": {
        "types": "./dist/links.d.mts",
        "default": "./dist/links.mjs"
      },
      "./eden": {
        "types": "./dist/eden.d.mts",
        "default": "./dist/eden.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@elysia/eden": "2.0.0-rc.1",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@oddsquad/vite-plugin-lit": "workspace:^",
    "seroval": "^1.8.0"
  },
  "peerDependencies": {
    "elysia": "^2.0.0-rc.4",
    "lit": "^3.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "elysia": "2.0.0-rc.4",
    "lit": "^3.3.3",
    "typebox": "^1.3.0",
    "vite": "catalog:"
  }
}
