{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": false,
    "types": ["node", "@oddsquad/vite-plugin-lit/client"]
  },
  "include": ["src", "demo", "test"]
}
