# Build outputs
/index.*
/build.*
/astro.*
/lib/
/types/
/standalone/
/dist/
/examples/*/dist/
*.tsbuildinfo
# What `pnpm pack` writes before a publish
*.tgz

# Tooling caches
/.e2e-tmp/
/examples/ssr/.e2e-tmp/
/examples/astro/.e2e-tmp/
/.vite/
/.fallow/
docs/dist/
docs/.astro/
examples/astro/.astro/

# Dependencies
node_modules/
docs/.generated/
# The Export snapshot default, written under whichever cwd the server ran in
lit-devtools-snapshot/

# Local env files (the playground's own .gitignore covers its directory)
.env
.env.*
!.env.example
.vitest/

# macOS Finder metadata
.DS_Store

# Private keys, such as the CRX signing key: never in the repo
*.pem

# Built by vp pack in the package.
/packages/lit-language-server/dist/
