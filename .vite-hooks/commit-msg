# Every non-merge commit says whether it belongs in the changelog. Untrailed
# commits are silently left out of the draft, which is how the 0.5.0 section
# had to be reconstructed by hand. See "Commits and the changelog" in AGENTS.md.
f="$1"
grep -qE '^Merge ' "$f" && exit 0
group=$(git interpret-trailers --parse < "$f" | sed -n 's/^Changelog: *//p' | head -1 | cut -d' ' -f1)
# A change to the language server or the Oxlint plugin also carries its own
# trailer, `Changelog-Language-Server:` or `Changelog-Oxlint-Plugin:`, for
# that package's CHANGELOG.md.
for trailer in Changelog-Language-Server Changelog-Oxlint-Plugin; do
  value=$(git interpret-trailers --parse < "$f" | sed -n "s/^$trailer: *//p" | head -1 | cut -d' ' -f1)
  case "$value" in
    ""|Added|Changed|Fixed|Removed) ;;
    *)
      echo "commit-msg: unknown $trailer group '$value' (Added | Changed | Fixed | Removed)"
      exit 1 ;;
  esac
done
case "$group" in
  Added|Changed|Fixed|Removed|skip) exit 0 ;;
  "")
    echo "commit-msg: add a 'Changelog: Added | Changed | Fixed | Removed | skip' trailer"
    echo "            (fold the user-facing entry under it on indented lines)"
    exit 1 ;;
  *)
    echo "commit-msg: unknown Changelog group '$group' (Added | Changed | Fixed | Removed | skip)"
    exit 1 ;;
esac
